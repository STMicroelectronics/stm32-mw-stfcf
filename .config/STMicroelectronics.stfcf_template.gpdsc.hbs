{{assign "jsonFilter" (JSONparse '{"cgroup": "STM32CubeMX2 Config", "csub": "STFCF"}')~}}
{{assign 'data' (@root.SWConfigurationAPI.getInstancesConfiguration @root.jsonFilter)~}}
{{assign "instance_0" @root.data.[0]~}}
{{assign "configs" @root.instance_0.settings.parameters ~}}

{{assign 'MY_SW_Instances' (@root.SWConfigurationAPI.getInstances "STMicroelectronics::Security:STM32CubeMX2 Config:STFCF")~}}
{{log 'MY_SW_Instances' @root.MY_SW_Instances~}}
{{assign 'stfcf_hal' false~}}
{{assign 'stfcf_cryptolib' false~}}
{{assign 'stfcf_mbedtls' false~}}
{{assign 'stfcf_kwe' false~}}

{{#each @root.MY_SW_Instances~}}
{{assign 'mystfcf' (@root.SWConfigurationAPI.getInstanceConfiguration this)~}}
{{log "mystfcf.settings.parameters" @root.mystfcf.settings.parameters~}}

{{#with @root.mystfcf.settings.parameters.core.basic ~}}

{{log 'MY_SW_Instances' @root.MY_SW_Instances~}}
{{log "alt_hal"   (eq implementations.aes_impl 'alt_hal')~}}
{{log "alt_stlib" (eq implementations.aes_impl 'alt_stcryptolib')~}}
{{log "mbedtls"   (eq implementations.aes_impl 'mbedtls')~}}
{{log "kwe"       (eq implementations.aes_impl 'kwe')~}}

{{#if (or (eq implementations.aes_impl 'alt_hal')
          (eq implementations.ccm_impl 'alt_hal')
          (eq implementations.gcm_impl 'alt_hal')
          (eq implementations.rsa_impl 'alt_hal')
          (eq implementations.ecdh_impl 'alt_hal')
          (eq implementations.ecdsa_impl 'alt_hal')
          (eq implementations.sha1_impl 'alt_hal')
          (eq implementations.sha256_impl 'alt_hal')
          (eq implementations.sha512_impl 'alt_hal')
          )}}{{assign 'stfcf_hal' true}}{{/if~}}

{{#if (or (eq implementations.aes_impl 'alt_stcryptolib')
          (eq implementations.ccm_impl 'alt_stcryptolib')
          (eq implementations.chachapoly_impl 'alt_stcryptolib')
          (eq implementations.gcm_impl 'alt_stcryptolib')
          (eq implementations.rsa_impl 'alt_stcryptolib')
          (eq implementations.ecdh_impl 'alt_stcryptolib')
          (eq implementations.ecdsa_impl 'alt_stcryptolib')
          (eq implementations.sha1_impl 'alt_stcryptolib')
          (eq implementations.sha256_impl 'alt_stcryptolib')
          (eq implementations.sha512_impl 'alt_stcryptolib')
          (eq implementations.cmac_impl 'alt_stcryptolib')
          (eq implementations.drbg_impl 'alt_stcryptolib')
          )}}{{assign 'stfcf_cryptolib' true}}{{/if~}}

{{#if (or (eq implementations.aes_impl 'mbedtls')
          (eq implementations.ccm_impl 'mbedtls')
          (eq implementations.chachapoly_impl 'mbedtls')
          (eq implementations.gcm_impl 'mbedtls')
          (eq implementations.rsa_impl 'mbedtls')
          (eq implementations.ecdh_impl 'mbedtls')
          (eq implementations.ecdsa_impl 'mbedtls')
          (eq implementations.md5_impl 'mbedtls')
          (eq implementations.sha1_impl 'mbedtls')
          (eq implementations.sha256_impl 'mbedtls')
          (eq implementations.sha512_impl 'mbedtls')
          (eq implementations.cmac_impl 'mbedtls')
          (eq implementations.drbg_impl 'mbedtls')
          )}}{{assign 'stfcf_mbedtls' true}}{{/if~}}

{{#if (or (eq implementations.aes_impl 'kwe')
          (eq implementations.ccm_impl 'kwe')
          (eq implementations.gcm_impl 'kwe')
          (eq implementations.rsa_impl 'kwe')
          (eq implementations.ecdh_impl 'kwe')
          (eq implementations.ecdsa_impl 'kwe')
          )}}{{assign 'stfcf_kwe' true}}{{/if~}}

{{/with~}}

{{log "mystfcf_hal_selection" @root.stfcf_hal~}}
{{log "mystfcf_cryptolib_selection" @root.stfcf_cryptolib~}}
{{log "mystfcf_mbedtls_selection" @root.stfcf_mbedtls~}}
{{log "mystfcf_kwe_selection" @root.stfcf_kwe~}}

{{/each~}}

<package xmlns:xs="http://www.w3.org/2001/XMLSchema-instance" schemaVersion="1.0" xs:noNamespaceSchemaLocation="https://github.com/Open-CMSIS-Pack/Open-CMSIS-Pack-Spec/blob/main/schema/PACK.xsd">
  {{!--Dedicated Helper that provides the PDSC PackVendor--}}
  <vendor>{{@root.pdscAPI.getPackVendor}}</vendor>
  {{!--Dedicated Helper that provides the PDSC PackName--}}
  <name>{{@root.pdscAPI.getPackName}}</name>
  <url>{{@root.pdscAPI.getPackURL}}</url>
  <releases>
    <release version="1.1.0" date="2026-07-24">
      - Optimize alternative file list generation
    </release>
    <release version="1.0.0" date="2026-04-20">
      - STFCF GPDSC Model Release
    </release>
  </releases>
  <description>STM32CubeMX2 Code Generation for STM32 Flexible Crypto Framework</description>
  <conditions>
    {{assign "conditions" (@root.pdscAPI.getAllPDSCConditionsWithFilters exclude="No STFCF generator, STFCF config condition,
    Mbed TLS Alt HAL condition, Mbed TLS Alt STCryptoLib condition, KWE condition,
    alt aes condition, alt ccm condition, alt chachapoly condition,
    alt cmac condition, alt entropy_hw condition,
    alt drbg condition, alt ecdh condition, alt ecdsa condition,
    alt gcm condition, alt rsa condition,
    alt sha1 condition, alt sha256 condition, alt sha512 condition,
    alt aes hal condition, alt ccm hal condition, alt ecp hal condition,
    alt gcm hal condition, alt rsa hal condition, alt ecdh hal condition,
    alt ecdsa hal condition, alt sha1 hal condition, alt sha256 hal condition,
    alt sha512 hal condition,
    alt aes stlib condition, alt ccm stlib condition, alt chachapoly stlib condition,
    alt cmac stlib condition, alt drbg stlib condition, alt gcm stlib condition,
    alt rsa stlib condition, alt ecdh stlib condition, alt ecdsa stlib condition,
    alt sha256 stlib condition, alt sha512 stlib condition" )~}}

    {{{@root.conditions}}}
    <condition id="STFCF config condition">
      <description>STFCF possible implementations</description>
      <deny Cclass="Security" Cgroup="STFCF" Csub="Core"/>
      <require Cclass="Security" Cgroup="STFCF" Csub="PSA API"/>
      {{!-- always present for rng/entropy init --}}
      <require Cclass="Security" Cgroup="STFCF" Csub="MbedTLS Alt Common"/>
      <require Cclass="Security" Cgroup="STFCF" Csub="MbedTLS Alt HAL"/>
      <require condition="Mbed TLS Alt HAL condition"/> {{!-- HAL IPs --}}
      {{#if @root.stfcf_cryptolib}}
      <require Cclass="Security" Cgroup="STFCF" Csub="MbedTLS Alt STCryptoLib"/>
      <require condition="Mbed TLS Alt STCryptoLib condition"/> {{!-- STCryptoLib components --}}
      {{/if}}
      {{#if @root.stfcf_kwe}}
      <require Cclass="Security" Cgroup="STFCF" Csub="KWE"/>
      <require condition="KWE condition"/>
      {{/if}}
    </condition>
    <condition id="Mbed TLS Alt STCryptoLib condition">
      <description>Requires STCryptoLib config component</description>
      <require Cclass="Security" Cgroup="STFCF" Csub="MbedTLS Alt Common"/>
      <require Cclass="Security" Cgroup="STCryptoLib" Csub="CMOX API"/>
      <require Cclass="Security" Cgroup="STM32CubeMX2 Config" Csub="STCryptoLib"/>
    </condition>
    <condition id="Mbed TLS Alt HAL condition">
      <description>Mbed TLS Alt HAL condition</description>
      <require Cclass="Security" Cgroup="STFCF" Csub="MbedTLS Alt Common"/>
      <require Cclass="Device" Cgroup="STM32CubeMX2 Config" Csub="RNG"/>
      {{!-- THE AES, SAES & CRYP instances will be selected from HW resource OneOf panel--}}
      {{!-- IS UP to user to bind them manually --}}
    </condition>
    <condition id="KWE condition">
      <description>Requires CCB HAL driver component</description>
      <require Cclass="Device" Cgroup="STM32CubeMX2 Config" Csub="CCB"/>
    </condition>

    {{#with @root.mystfcf.settings.parameters.core.basic~}}
    {{assign 'mystfcf' @root.mystfcf}}
    <condition id="alt aes condition">
      <description>Enable aes_alt implementation</description>
    {{#if (eq implementations.aes_impl 'alt_hal')}}
      <require Cclass="Security" Cgroup="STFCF" Csub="MbedTLS Alt HAL"/>
    {{else if (eq implementations.aes_impl 'alt_stcryptolib')}}
      <require Cclass="Security" Cgroup="STFCF" Csub="MbedTLS Alt STCryptoLib"/>
    {{else if (eq implementations.aes_impl 'kwe')}}
      <require Cclass="Security" Cgroup="STFCF" Csub="KWE"/>
    {{else}}
      <deny Cclass="Security" Cgroup="STFCF" Csub="PSA API"/> {{!-- cdt == false => file not generated --}}
    {{/if}}
    </condition>
    <condition id="alt aes hal condition">
      <description>Enable aes_alt_hal implementation</description>
    {{#if (eq implementations.aes_impl 'alt_hal')}}
      <require Cclass="Security" Cgroup="STFCF" Csub="MbedTLS Alt HAL"/>
    {{else}}
      <deny Cclass="Security" Cgroup="STFCF" Csub="PSA API"/>
    {{/if}}
    </condition>
    <condition id="alt aes_aes hal condition">
      <description>Enable aes_alt_hal implementation based on AES IP</description>
    {{#if (or (and (eq implementations.aes_impl 'kwe')
                   (eq @root.mystfcf.settings.parameters.resourcesAllocation.hw_resources.periph_alloc_for_aes.selection 'SAES'))
              (and (eq implementations.aes_impl 'alt_hal')
                   (or (eq @root.mystfcf.settings.parameters.resourcesAllocation.hw_resources.periph_alloc_for_aes.selection 'AES')
                       (eq @root.mystfcf.settings.parameters.resourcesAllocation.hw_resources.periph_alloc_for_aes.selection 'SAES'))) )}}
      <require Cclass="Security" Cgroup="STFCF" Csub="MbedTLS Alt HAL"/>
    {{else}}
      <deny Cclass="Security" Cgroup="STFCF" Csub="PSA API"/>
    {{/if}}
    </condition>
    <condition id="alt cryp_aes hal condition">
      <description>Enable aes_alt_hal implementation based on CRYP IP</description>
    {{#if (and (eq implementations.aes_impl 'alt_hal')
               (eq @root.mystfcf.settings.parameters.resourcesAllocation.hw_resources.periph_alloc_for_aes.selection 'CRYP'))}}
      <require Cclass="Security" Cgroup="STFCF" Csub="MbedTLS Alt HAL"/>
    {{else}}
      <deny Cclass="Security" Cgroup="STFCF" Csub="PSA API"/>
    {{/if}}
    </condition>
    <condition id="alt aes stlib condition">
      <description>Enable aes_alt_stlib implementation</description>
    {{#if (eq implementations.aes_impl 'alt_stcryptolib')}}
      <require Cclass="Security" Cgroup="STFCF" Csub="MbedTLS Alt STCryptoLib"/>
    {{else}}
      <deny Cclass="Security" Cgroup="STFCF" Csub="PSA API"/>
    {{/if}}
    </condition>
    <condition id="alt ccm condition">
      <description>Enable ccm_alt implementation</description>
    {{#if (eq implementations.ccm_impl 'alt_hal')}}
      <require Cclass="Security" Cgroup="STFCF" Csub="MbedTLS Alt HAL"/>
    {{else if (eq implementations.ccm_impl 'alt_stcryptolib')}}
      <require Cclass="Security" Cgroup="STFCF" Csub="MbedTLS Alt STCryptoLib"/>
    {{else if (eq implementations.ccm_impl 'kwe')}}
      <require Cclass="Security" Cgroup="STFCF" Csub="KWE"/>
    {{else}}
      <deny Cclass="Security" Cgroup="STFCF" Csub="PSA API"/>
    {{/if}}
    </condition>
    <condition id="alt ccm hal condition">
      <description>Enable ccm_alt_hal implementation</description>
    {{#if (eq implementations.ccm_impl 'alt_hal')}}
      <require Cclass="Security" Cgroup="STFCF" Csub="MbedTLS Alt HAL"/>
    {{else}}
      <deny Cclass="Security" Cgroup="STFCF" Csub="PSA API"/>
    {{/if}}
    </condition>
    <condition id="alt aes_ccm hal condition">
      <description>Enable ccm_alt_hal implementation based on AES IP</description>
    {{#if (and (eq implementations.ccm_impl 'alt_hal')
               (or (eq @root.mystfcf.settings.parameters.resourcesAllocation.hw_resources.periph_alloc_for_ccm.selection 'AES')
                   (eq @root.mystfcf.settings.parameters.resourcesAllocation.hw_resources.periph_alloc_for_ccm.selection 'SAES')))}}
      <require Cclass="Security" Cgroup="STFCF" Csub="MbedTLS Alt HAL"/>
    {{else}}
      <deny Cclass="Security" Cgroup="STFCF" Csub="PSA API"/>
    {{/if}}
    </condition>
    <condition id="alt cryp_ccm hal condition">
      <description>Enable ccm_alt_hal implementation based on CRYP IP</description>
    {{#if (and (eq implementations.ccm_impl 'alt_hal')
               (eq @root.mystfcf.settings.parameters.resourcesAllocation.hw_resources.periph_alloc_for_ccm.selection 'CRYP'))}}
      <require Cclass="Security" Cgroup="STFCF" Csub="MbedTLS Alt HAL"/>
    {{else}}
      <deny Cclass="Security" Cgroup="STFCF" Csub="PSA API"/>
    {{/if}}
    </condition>
    <condition id="alt ccm stlib condition">
      <description>Enable ccm_alt_stlib implementation</description>
    {{#if (eq implementations.ccm_impl 'alt_stcryptolib')}}
      <require Cclass="Security" Cgroup="STFCF" Csub="MbedTLS Alt STCryptoLib"/>
    {{else}}
      <deny Cclass="Security" Cgroup="STFCF" Csub="PSA API"/>
    {{/if}}
    </condition>
    <condition id="alt chachapoly condition">
      <description>Enable chachapoly_alt implementation</description>
      <!-- Works only with ALT STCryptoLib -->
    {{#if (eq implementations.chachapoly_impl 'alt_stcryptolib')}}
      <require Cclass="Security" Cgroup="STFCF" Csub="MbedTLS Alt STCryptoLib"/>
    {{else}}
      <deny Cclass="Security" Cgroup="STFCF" Csub="PSA API"/>
    {{/if}}
    </condition>
    <condition id="alt chachapoly stlib condition">
      <description>Enable chachapoly_alt_stlib implementation</description>
    {{#if (eq implementations.chachapoly_impl 'alt_stcryptolib')}}
      <require Cclass="Security" Cgroup="STFCF" Csub="MbedTLS Alt STCryptoLib"/>
    {{else}}
      <deny Cclass="Security" Cgroup="STFCF" Csub="PSA API"/>
    {{/if}}
    </condition>
    <condition id="alt gcm condition">
      <description>Enable gcm_alt implementation</description>
    {{#if (eq implementations.gcm_impl 'alt_hal')}}
      <require Cclass="Security" Cgroup="STFCF" Csub="MbedTLS Alt HAL"/>
    {{else if (eq implementations.gcm_impl 'alt_stcryptolib')}}
      <require Cclass="Security" Cgroup="STFCF" Csub="MbedTLS Alt STCryptoLib"/>
    {{else if (eq implementations.gcm_impl 'kwe')}}
      <require Cclass="Security" Cgroup="STFCF" Csub="KWE"/>
    {{else}}
      <deny Cclass="Security" Cgroup="STFCF" Csub="PSA API"/>
    {{/if}}
    </condition>
    <condition id="alt gcm hal condition">
      <description>Enable gcm_alt_hal implementation</description>
    {{#if (eq implementations.gcm_impl 'alt_hal')}}
      <require Cclass="Security" Cgroup="STFCF" Csub="MbedTLS Alt HAL"/>
    {{else}}
      <deny Cclass="Security" Cgroup="STFCF" Csub="PSA API"/>
    {{/if}}
    </condition>
    <condition id="alt aes_gcm hal condition">
      <description>Enable gcm_alt_hal implementation based on AES IP</description>
    {{#if (and (eq implementations.gcm_impl 'alt_hal')
               (or (eq @root.mystfcf.settings.parameters.resourcesAllocation.hw_resources.periph_alloc_for_gcm.selection 'AES')
                   (eq @root.mystfcf.settings.parameters.resourcesAllocation.hw_resources.periph_alloc_for_gcm.selection 'SAES')))}}
      <require Cclass="Security" Cgroup="STFCF" Csub="MbedTLS Alt HAL"/>
    {{else}}
      <deny Cclass="Security" Cgroup="STFCF" Csub="PSA API"/>
    {{/if}}
    </condition>
    <condition id="alt cryp_gcm hal condition">
      <description>Enable gcm_alt_hal implementation based on CRYP IP</description>
    {{#if (and (eq implementations.gcm_impl 'alt_hal')
               (eq @root.mystfcf.settings.parameters.resourcesAllocation.hw_resources.periph_alloc_for_gcm.selection 'CRYP'))}}
      <require Cclass="Security" Cgroup="STFCF" Csub="MbedTLS Alt HAL"/>
    {{else}}
      <deny Cclass="Security" Cgroup="STFCF" Csub="PSA API"/>
    {{/if}}
    </condition>
    <condition id="alt gcm stlib condition">
      <description>Enable gcm_alt_stlib implementation</description>
    {{#if (eq implementations.gcm_impl 'alt_stcryptolib')}}
      <require Cclass="Security" Cgroup="STFCF" Csub="MbedTLS Alt STCryptoLib"/>
    {{else}}
      <deny Cclass="Security" Cgroup="STFCF" Csub="PSA API"/>
    {{/if}}
    </condition>
    <condition id="alt cmac condition">
      <description>Enable cmac_alt implementation</description>
    {{#if (eq implementations.cmac_impl 'alt_stcryptolib')}}
      <require Cclass="Security" Cgroup="STFCF" Csub="MbedTLS Alt STCryptoLib"/>
    {{else}}
      <deny Cclass="Security" Cgroup="STFCF" Csub="PSA API"/>
    {{/if}}
    </condition>
    <condition id="alt cmac stlib condition">
      <description>Enable cmac_alt_stlib implementation</description>
    {{#if (eq implementations.cmac_impl 'alt_stcryptolib')}}
      <require Cclass="Security" Cgroup="STFCF" Csub="MbedTLS Alt STCryptoLib"/>
    {{else}}
      <deny Cclass="Security" Cgroup="STFCF" Csub="PSA API"/>
    {{/if}}
    </condition>
    <condition id="alt drbg condition">
      <description>Enable drbg_alt implementation</description>
    {{#if (eq implementations.drbg_impl 'alt_stcryptolib')}}
      <require Cclass="Security" Cgroup="STFCF" Csub="MbedTLS Alt STCryptoLib"/>
    {{else}}
      <deny Cclass="Security" Cgroup="STFCF" Csub="PSA API"/>
    {{/if}}
    </condition>
    <condition id="alt drbg stlib condition">
      <description>Enable drbg_alt_stlib implementation</description>
    {{#if (eq implementations.drbg_impl 'alt_stcryptolib')}}
      <require Cclass="Security" Cgroup="STFCF" Csub="MbedTLS Alt STCryptoLib"/>
    {{else}}
      <deny Cclass="Security" Cgroup="STFCF" Csub="PSA API"/>
    {{/if}}
    </condition>
    <condition id="alt entropy_hw condition">
      <description>Enable entropy_hw_alt implementation</description>
      <!-- Works only with ALT HAL -->
    {{#if (eq implementations.drbg_impl 'alt_stcryptolib')}}
      <deny Cclass="Security" Cgroup="STFCF" Csub="PSA API"/>
    {{else}}
      <require Cclass="Security" Cgroup="STFCF" Csub="MbedTLS Alt HAL"/>
    {{/if}}
    </condition>
    <condition id="alt rsa condition">
      <description>Enable rsa_alt implementation</description>
    {{#if (eq implementations.rsa_impl 'alt_hal')}}
      <require Cclass="Security" Cgroup="STFCF" Csub="MbedTLS Alt HAL"/>
    {{else if (eq implementations.rsa_impl 'alt_stcryptolib')}}
      <require Cclass="Security" Cgroup="STFCF" Csub="MbedTLS Alt STCryptoLib"/>
    {{else if (eq implementations.rsa_impl 'kwe')}}
      <require Cclass="Security" Cgroup="STFCF" Csub="KWE"/>
    {{else}}
      <deny Cclass="Security" Cgroup="STFCF" Csub="PSA API"/>
    {{/if}}
    </condition>
    <condition id="alt rsa hal condition">
      <description>Enable rsa_alt_hal implementation</description>
    {{#if (eq implementations.rsa_impl 'alt_hal')}}
      <require Cclass="Security" Cgroup="STFCF" Csub="MbedTLS Alt HAL"/>
    {{else}}
      <deny Cclass="Security" Cgroup="STFCF" Csub="PSA API"/>
    {{/if}}
    </condition>
    <condition id="alt rsa stlib condition">
      <description>Enable rsa_alt_stlib implementation</description>
    {{#if (eq implementations.rsa_impl 'alt_stcryptolib')}}
      <require Cclass="Security" Cgroup="STFCF" Csub="MbedTLS Alt STCryptoLib"/>
    {{else}}
      <deny Cclass="Security" Cgroup="STFCF" Csub="PSA API"/>
    {{/if}}
    </condition>
    <condition id="alt ecp hal condition">
      <description>Enable ecp_alt implementation</description>
      <accept condition="alt ecdh hal condition"/>
      <accept condition="alt ecdsa hal condition"/>
    </condition>
    <condition id="alt ecdh condition">
      <description>Enable ecdh_alt implementation</description>
    {{#if (eq implementations.ecdh_impl 'alt_hal')}}
      <require Cclass="Security" Cgroup="STFCF" Csub="MbedTLS Alt HAL"/>
    {{else if (eq implementations.ecdh_impl 'alt_stcryptolib')}}
      <require Cclass="Security" Cgroup="STFCF" Csub="MbedTLS Alt STCryptoLib"/>
    {{else if (eq implementations.ecdh_impl 'kwe')}}
      <require Cclass="Security" Cgroup="STFCF" Csub="KWE"/>
    {{else}}
      <deny Cclass="Security" Cgroup="STFCF" Csub="PSA API"/>
    {{/if}}
    </condition>
    <condition id="alt ecdh hal condition">
      <description>Enable ecdh_alt_hal implementation</description>
    {{#if (or (eq implementations.ecdh_impl 'alt_hal')
              (eq implementations.ecdh_impl 'kwe'))}}
      <require Cclass="Security" Cgroup="STFCF" Csub="MbedTLS Alt HAL"/>
    {{else}}
      <deny Cclass="Security" Cgroup="STFCF" Csub="PSA API"/>
    {{/if}}
    </condition>
    <condition id="alt ecdh stlib condition">
      <description>Enable ecdh_alt_stlib implementation</description>
    {{#if (eq implementations.ecdh_impl 'alt_stcryptolib')}}
      <require Cclass="Security" Cgroup="STFCF" Csub="MbedTLS Alt STCryptoLib"/>
    {{else}}
      <deny Cclass="Security" Cgroup="STFCF" Csub="PSA API"/>
    {{/if}}
    </condition>
    <condition id="alt ecdsa condition">
      <description>Enable ecdsa_alt implementation</description>
    {{#if (eq implementations.ecdsa_impl 'alt_hal')}}
      <require Cclass="Security" Cgroup="STFCF" Csub="MbedTLS Alt HAL"/>
    {{else if (eq implementations.ecdsa_impl 'alt_stcryptolib')}}
      <require Cclass="Security" Cgroup="STFCF" Csub="MbedTLS Alt STCryptoLib"/>
    {{else if (eq implementations.ecdsa_impl 'kwe')}}
      <require Cclass="Security" Cgroup="STFCF" Csub="KWE"/>
    {{else}}
      <deny Cclass="Security" Cgroup="STFCF" Csub="PSA API"/>
    {{/if}}
    </condition>
    <condition id="alt ecdsa hal condition">
      <description>Enable ecdsa_alt_hal implementation</description>
    {{#if (or (eq implementations.ecdsa_impl 'alt_hal')
              (eq implementations.ecdsa_impl 'kwe'))}}
      <require Cclass="Security" Cgroup="STFCF" Csub="MbedTLS Alt HAL"/>
    {{else}}
      <deny Cclass="Security" Cgroup="STFCF" Csub="PSA API"/>
    {{/if}}
    </condition>
    <condition id="alt ecdsa stlib condition">
      <description>Enable ecdsa_alt_stlib implementation</description>
    {{#if (eq implementations.ecdsa_impl 'alt_stcryptolib')}}
      <require Cclass="Security" Cgroup="STFCF" Csub="MbedTLS Alt STCryptoLib"/>
    {{else}}
      <deny Cclass="Security" Cgroup="STFCF" Csub="PSA API"/>
    {{/if}}
    </condition>
    <condition id="alt sha1 condition">
      <description>Enable sha1_alt implementation</description>
      <!-- Works only with ALT HAL -->
    {{#if (eq implementations.sha1_impl 'alt_hal') }}
      <require Cclass="Security" Cgroup="STFCF" Csub="MbedTLS Alt HAL"/>
    {{else}}
      <deny Cclass="Security" Cgroup="STFCF" Csub="PSA API"/>
    {{/if}}
    </condition>
    <condition id="alt sha1 hal condition">
      <description>Enable sha1_alt_hal implementation</description>
    {{#if (eq implementations.sha1_impl 'alt_hal') }}
      <require Cclass="Security" Cgroup="STFCF" Csub="MbedTLS Alt HAL"/>
    {{else}}
      <deny Cclass="Security" Cgroup="STFCF" Csub="PSA API"/>
    {{/if}}
    </condition>
    <condition id="alt sha256 condition">
      <description>Enable sha256_alt implementation</description>
    {{#if (eq implementations.sha256_impl 'alt_hal')}}
      <require Cclass="Security" Cgroup="STFCF" Csub="MbedTLS Alt HAL"/>
    {{else if (eq implementations.sha256_impl 'alt_stcryptolib')}}
      <require Cclass="Security" Cgroup="STFCF" Csub="MbedTLS Alt STCryptoLib"/>
    {{else}}
      <deny Cclass="Security" Cgroup="STFCF" Csub="PSA API"/>
    {{/if}}
    </condition>
    <condition id="alt sha256 hal condition">
      <description>Enable sha256_alt_hal implementation</description>
    {{#if (eq implementations.sha256_impl 'alt_hal')}}
      <require Cclass="Security" Cgroup="STFCF" Csub="MbedTLS Alt HAL"/>
    {{else}}
      <deny Cclass="Security" Cgroup="STFCF" Csub="PSA API"/>
    {{/if}}
    </condition>
    <condition id="alt sha256 stlib condition">
      <description>Enable sha256_alt_stlib implementation</description>
    {{#if (eq implementations.sha256_impl 'alt_stcryptolib')}}
      <require Cclass="Security" Cgroup="STFCF" Csub="MbedTLS Alt STCryptoLib"/>
    {{else}}
      <deny Cclass="Security" Cgroup="STFCF" Csub="PSA API"/>
    {{/if}}
    </condition>
    <condition id="alt sha512 condition">
      <description>Enable sha512_alt implementation</description>
    {{#if (eq implementations.sha512_impl 'alt_hal')}}
      <require Cclass="Security" Cgroup="STFCF" Csub="MbedTLS Alt HAL"/>
    {{else if (eq implementations.sha512_impl 'alt_stcryptolib')}}
      <require Cclass="Security" Cgroup="STFCF" Csub="MbedTLS Alt STCryptoLib"/>
    {{else}}
      <deny Cclass="Security" Cgroup="STFCF" Csub="PSA API"/>
    {{/if}}
    </condition>
    <condition id="alt sha512 hal condition">
      <description>Enable sha512_alt_hal implementation</description>
    {{#if (eq implementations.sha512_impl 'alt_hal')}}
      <require Cclass="Security" Cgroup="STFCF" Csub="MbedTLS Alt HAL"/>
    {{else}}
      <deny Cclass="Security" Cgroup="STFCF" Csub="PSA API"/>
    {{/if}}
    </condition>
    <condition id="alt sha512 stlib condition">
      <description>Enable sha512_alt_stlib implementation</description>
    {{#if (eq implementations.sha512_impl 'alt_stcryptolib')}}
      <require Cclass="Security" Cgroup="STFCF" Csub="MbedTLS Alt STCryptoLib"/>
    {{else}}
      <deny Cclass="Security" Cgroup="STFCF" Csub="PSA API"/>
    {{/if}}
    </condition>
    {{/with}}
  </conditions>

